
.. _filters-wordpress-hard:

wordpress-hard.conf
-------------------

.. note::
   This filter is auto-generated.

.. code-block:: ini

   # Fail2Ban filter for hard failures
   #

   [INCLUDES]

   before = common.conf

   [Definition]

   _daemon = (?:wordpress|wp)
   _tail = (?: on <F-SITE_INLINE>\S+(?:/\S+)?</F-SITE_INLINE>)? from <ADDR>

   failregex = ^%(__prefix_line)sBlocked user enumeration attempt<_tail>$ ; id=user-enum
               ^%(__prefix_line)sBlocked username authentication attempt for <F-ALT_USER>.*</F-ALT_USER><_tail>$ ; id=blocked-username
               ^%(__prefix_line)s(?:REST|XML-RPC) authentication attempt(?: \(repeat\))? for unknown user <F-ALT_USER>.*</F-ALT_USER><_tail>$ ; id=auth-api-unknown
               ^%(__prefix_line)sBlocked authentication attempt for <F-ALT_USER>.*</F-ALT_USER><_tail>$ ; id=blocked-user
               ^%(__prefix_line)sPingback error <F-ERRCODE>\d+</F-ERRCODE> generated by "<F-PINGBACK_FROM_URL>.*</F-PINGBACK_FROM_URL>" to "<F-PINGBACK_TO_URL>.*</F-PINGBACK_TO_URL>"<_tail>$ ; id=pingback-error
               ^%(__prefix_line)sXML-RPC request blocked<_tail>$ ; id=xmlrpc-blocked
               ^%(__prefix_line)sXML-RPC multicall authentication failure<_tail>$ ; id=xmlrpc-multicall-auth
               ^%(__prefix_line)sImmediately block connections<_tail>$ ; id=immediate-block
               ^%(__prefix_line)sAttempted access to honeypot \(robots.txt: <F-REQUEST_PATH>.*?</F-REQUEST_PATH>\)<_tail>$ ; id=honeypot-robots
               ^%(__prefix_line)sAkismet discarded spam comment<_tail>$ ; id=comment-spam-akismet
               ^%(__prefix_line)sBlocked access <F-HTTP_STATUS>\d\d\d</F-HTTP_STATUS> from country '<F-ISO_CODE>..</F-ISO_CODE>'<_tail>$ ; id=blocked-country
               ^%(__prefix_line)sBlocked access <F-HTTP_STATUS>\d\d\d</F-HTTP_STATUS> from unknown country<_tail>$ ; id=blocked-country-unknown
               ^%(__prefix_line)sSpam <F-COMMENT_TYPE>.+</F-COMMENT_TYPE> <F-COMMENT_ID>\d+</F-COMMENT_ID><_tail>$ ; id=comment-spam
               ^%(__prefix_line)sTrackback failed for post <F-POST_ID>\d+</F-POST_ID> by "<F-TRACKBACK_URL>.+</F-TRACKBACK_URL>"<_tail>$ ; id=trackback-failed
               ^%(__prefix_line)sUntrusted X-Forwarded-For header<_tail>$ ; id=untrusted-proxy

   ignoreregex =

   journalmatch = SYSLOG_IDENTIFIER=wordpress

